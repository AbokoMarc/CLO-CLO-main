{
  "appId": "com.cloclo.app",
  "appName": "Clo-Clo",
  "webDir": "www",
  "server": {
    "url": "https://clo-clo-main.vercel.app",
    "cleartext": false,
    "androidScheme": "https",
    "allowNavigation": [
      "clo-clo-main.vercel.app",
      "clo-clo-main.onrender.com",
      "*.tile.openstreetmap.org",
      "router.project-osrm.org",
      "fonts.googleapis.com",
      "fonts.gstatic.com"
    ]
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "BackgroundGeolocation": {}
  }
}
