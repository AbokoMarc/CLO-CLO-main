# ── Paiement en ligne (Mobile Money) — à ajouter dans les variables d'environnement Render ──
# Option 1 : manuel (aucun compte prestataire requis). Le client envoie l'argent à VOTRE numéro et saisit la référence SMS ; l'admin valide.
PAYMENT_PROVIDER=manual
MOMO_NUMBER=6XXXXXXXX        # votre numéro MTN MoMo marchand
OM_NUMBER=6XXXXXXXX          # votre numéro Orange Money marchand

# Option 2 : automatique via CinetPay (il faut créer un compte marchand CinetPay et obtenir ces identifiants)
# PAYMENT_PROVIDER=cinetpay
# CINETPAY_API_KEY=...
# CINETPAY_SITE_ID=...
# PUBLIC_API_URL=https://clo-clo-main.onrender.com   # URL publique de ce backend (webhook de confirmation)
# FRONT_URL=https://votre-site.vercel.app
