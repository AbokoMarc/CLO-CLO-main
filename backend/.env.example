# Copier ce fichier en ".env" et renseigner de VRAIES valeurs.
# Ne jamais committer le fichier ".env" réel dans le dépôt.
# Le serveur refuse de démarrer si JWT_SECRET est absent.

# Port d'écoute du serveur
PORT=4000

# Secret utilisé pour signer les tokens d'authentification.
# OBLIGATOIRE. Générer une vraie valeur aléatoire :
#   openssl rand -hex 32
JWT_SECRET=

# Origine autorisée pour les requêtes CORS depuis le frontend.
# En production, mettre l'URL EXACTE du frontend déployé
# (ex: https://cloclo.vercel.app) — jamais "*" en production.
CORS_ORIGIN=*

# Identifiants du compte administrateur, créés automatiquement
# au premier démarrage si aucun admin n'existe encore.
# ADMIN_PASSWORD doit faire au moins 8 caractères.
ADMIN_USERNAME=
ADMIN_PASSWORD=

NODE_ENV=production

# ── Base de données Turso (libSQL) ──────────────────────────
# OBLIGATOIRE en production pour ne PAS perdre les données à
# chaque redéploiement/redémarrage sur Render (le disque de
# Render gratuit est éphémère, Turso ne l'est pas).
#
# 1) Créer un compte gratuit sur https://turso.tech
# 2) turso db create cloclo
# 3) turso db show cloclo --url          -> TURSO_DATABASE_URL
# 4) turso db tokens create cloclo       -> TURSO_AUTH_TOKEN
#
# En local, laissez ces deux variables vides : le serveur utilise
# alors automatiquement un fichier SQLite local (backend/data/cloclo.sqlite).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
